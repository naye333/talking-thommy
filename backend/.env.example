# Copia este archivo como .env y llena los valores. Nunca subas .env a GitHub.

PUERTO=3000
ENTORNO=desarrollo

# Cadena de conexión de Neon (usa la versión "pooled")
# Ejemplo: postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/talking_thommy?sslmode=require
DATABASE_URL=

# Orígenes permitidos para CORS, separados por coma
ORIGENES_PERMITIDOS=http://localhost:8081

# Secreto para firmar los tokens de sesión (JWT). Obligatorio en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=
JWT_EXPIRACION=7d

# Límite de audio por turno en bytes (25 MB es el máximo que acepta Whisper en Groq)
MAX_BYTES_AUDIO_TURNO=26214400
