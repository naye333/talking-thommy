# Copiar como .env y ajustar. Todas las variables son opcionales (ver config/settings.py).

# --- Servidor ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Orígenes del frontend separados por comas. "*" solo en desarrollo.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Si se define, el frontend debe enviar la cabecera X-API-Key con este valor.
API_KEY=

# --- Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
# Qwen3: desactivar el modo razonamiento (mucho mas rapido en CPU). Para qwen2.5 dejar vacio.
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0.5
OLLAMA_NUM_CTX=2048
OLLAMA_MAX_TOKENS=200
OLLAMA_KEEP_ALIVE=30m
HISTORY_MAX_MESSAGES=12

# --- Whisper.cpp ---
WHISPER_BIN=bin/whisper/Release/whisper-cli.exe
WHISPER_MODEL=models/whisper/ggml-base.en.bin
WHISPER_THREADS=4
# Ruta completa a ffmpeg si no está en el PATH
FFMPEG_BIN=ffmpeg

# --- Piper ---
PIPER_VOICES_DIR=models/piper
PIPER_VOICE=en_US-kristin-medium
PIPER_LENGTH_SCALE=1.0
# Tono de la voz: 1.0 = original; 1.2-1.4 = voz de nino (requiere ffmpeg)
PIPER_PITCH=1.28
# Formato del audio de Thommy: mp3 (recomendado para la app) o wav
AUDIO_FORMAT=mp3

# --- Audio / almacenamiento ---
MAX_UPLOAD_MB=10
MIN_AUDIO_SECONDS=0.3
MAX_AUDIO_SECONDS=60
KEEP_STUDENT_AUDIO=false
AUDIO_RETENTION_MINUTES=120
SESSION_TIMEOUT_MINUTES=60
CLEANUP_INTERVAL_SECONDS=300
MAX_CONCURRENT_PIPELINES=1
